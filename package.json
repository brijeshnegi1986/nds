{
  "name": "@jeshapps/nds",
  "version": "0.1.0",
  "private": true,
  "description": "NDS, the shared design system for JeshApps projects.",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "tokens:import": "python3 scripts/import-figma-tokens.py",
    "tokens:validate": "python3 scripts/validate-tokens.py",
    "tokens:build": "npm run tokens:validate && node scripts/build-tokens.mjs && python3 scripts/validate-tokens.py --distribution",
    "react:build": "tsc -p components/react/tsconfig.json && cp components/react/styles.css dist/react/styles.css",
    "react:test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.1",
    "style-dictionary": "^5.5.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/*": "./dist/css/*.css",
    "./dist/*": "./dist/*",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "react-easy-crop": "^6.2.4"
  }
}
